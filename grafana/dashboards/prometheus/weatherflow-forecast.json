    {
      "type": "row",
      "title": "Days ahead",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 1
      },
      "id": 6
    },
    {
      "type": "table",
      "title": "Daily forecast",
      "description": "Ahead is days from today; 0 is today.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "weatherflow_forecast_daily_air_temp_high{station_name=~\"$station_name\"}",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "weatherflow_forecast_daily_air_temp_low{station_name=~\"$station_name\"}",
          "legendFormat": "",
          "refId": "B",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "weatherflow_forecast_daily_precip_probability{station_name=~\"$station_name\"}",
          "legendFormat": "",
          "refId": "C",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "collector_type": true,
              "station_id": true
            },
            "renameByName": {
              "Value #A": "High",
              "Value #B": "Low",
              "Value #C": "Chance of rain",
              "days_ahead": "Ahead"
            },
            "indexByName": {
              "days_ahead": 0
            }
          }
        },
        {
          "id": "convertFieldType",
          "options": {
            "conversions": [
              {
                "targetField": "Ahead",
                "destinationType": "number"
              }
            ]
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Ahead",
                "desc": false
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 1
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "High"
            },
            "properties": [
              {
                "id": "unit",
                "value": "celsius"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Low"
            },
            "properties": [
              {
                "id": "unit",
                "value": "celsius"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Chance of rain"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 24,
        "h": 10
      },
      "id": 7
    },
    {
      "type": "row",
      "title": "Hours ahead",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 1
      },
      "id": 8
    },
    {
      "type": "table",
      "title": "Hourly forecast",
      "description": "Ahead is hours from now.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "weatherflow_forecast_hourly_air_temperature{station_name=~\"$station_name\"}",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "weatherflow_forecast_hourly_relative_humidity{station_name=~\"$station_name\"}",
          "legendFormat": "",
          "refId": "B",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "weatherflow_forecast_hourly_precip_probability{station_name=~\"$station_name\"}",
          "legendFormat": "",
          "refId": "C",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "weatherflow_forecast_hourly_wind_avg{station_name=~\"$station_name\"}",
          "legendFormat": "",
          "refId": "D",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "weatherflow_forecast_hourly_sea_level_pressure{station_name=~\"$station_name\"}",
          "legendFormat": "",
          "refId": "E",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "collector_type": true,
              "station_id": true
            },
            "renameByName": {
              "Value #A": "Temperature",
              "Value #B": "Humidity",
              "Value #C": "Chance of rain",
              "Value #D": "Wind",
              "Value #E": "Pressure",
              "hours_ahead": "Ahead"
            },
            "indexByName": {
              "hours_ahead": 0
            }
          }
        },
        {
          "id": "convertFieldType",
          "options": {
            "conversions": [
              {
                "targetField": "Ahead",
                "destinationType": "number"
              }
            ]
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Ahead",
                "desc": false
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 1
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Temperature"
            },
            "properties": [
              {
                "id": "unit",
                "value": "celsius"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Humidity"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Chance of rain"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Wind"
            },
            "properties": [
              {
                "id": "unit",
                "value": "velocityms"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Pressure"
            },
            "properties": [
              {
                "id": "unit",
                "value": "pressurembar"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 24,
        "h": 12
      },
      "id": 9
    },
    {
      "type": "row",
      "title": "Forecast vs observed",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 24,
        "h": 1
      },
      "id": 10
    },
    {
      "type": "timeseries",
      "title": "Temperature: forecast an hour earlier vs observed",
      "description": "Compares each hour's observation with the forecast made an hour before.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "weatherflow_obs_air_temperature{station_name=~\"$station_name\",collector_type=\"primary\"}",
          "legendFormat": "Observed",
          "refId": "A",
          "instant": false,
          "range": true,
          "format": "time_series"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "weatherflow_forecast_hourly_air_temperature{station_name=~\"$station_name\",hours_ahead=\"1\"} offset 1h",
          "legendFormat": "Forecast 1h ahead",
          "refId": "B",
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": 300000,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 24,
        "h": 9
      },
      "id": 11
    }
  ]
