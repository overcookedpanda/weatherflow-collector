{
  "uid": "weatherflow-prom-current",
  "title": "WeatherFlow - Current Conditions (Prometheus)",
  "description": "Live readings from the collector's Prometheus output.",
  "tags": [
    "weatherflow",
    "prometheus",
    "current"
  ],
  "editable": true,
  "graphTooltip": 1,
  "refresh": "1m",
  "schemaVersion": 39,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timezone": "browser",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      },
      {
        "name": "station_name",
        "label": "Station",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(weatherflow_obs_air_temperature, station_name)",
          "refId": "StationName"
        },
        "definition": "label_values(weatherflow_obs_air_temperature, station_name)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {},
        "sort": 1,
        "hide": 0
      },
      {
        "name": "collector_type",
        "label": "Source",
        "description": "primary is the source set by WEATHERFLOW_COLLECTOR_PRIMARY_SOURCE.",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(weatherflow_obs_air_temperature, collector_type)",
          "refId": "CollectorType"
        },
        "definition": "label_values(weatherflow_obs_air_temperature, collector_type)",
        "refresh": 2,
        "current": {
          "text": "primary",
          "value": "primary"
        },
        "sort": 1,
        "includeAll": false,
        "multi": false,
        "hide": 0
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "weatherflow",
        "prometheus"
      ],
