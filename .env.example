# Copy to .env and fill in. .env is git-ignored; never commit real values.

# Tempest personal access token (tempestwx.com > Settings > Data Authorizations)
WEATHERFLOW_COLLECTOR_API_TOKEN=<YOUR_TEMPEST_TOKEN>

# Time zone for the container, e.g. America/Chicago
TZ=UTC

# InfluxDB v2 target
WEATHERFLOW_COLLECTOR_INFLUXDB_URL=<YOUR_INFLUXDB_URL>
WEATHERFLOW_COLLECTOR_INFLUXDB_TOKEN=<YOUR_INFLUXDB_WRITE_TOKEN>
WEATHERFLOW_COLLECTOR_INFLUXDB_ORG=<YOUR_INFLUXDB_ORG>
WEATHERFLOW_COLLECTOR_INFLUXDB_BUCKET=weatherflow

# Collectors
WEATHERFLOW_COLLECTOR_COLLECTOR_UDP_ENABLED=True
WEATHERFLOW_COLLECTOR_COLLECTOR_WEBSOCKET_ENABLED=True
WEATHERFLOW_COLLECTOR_COLLECTOR_REST_FORECASTS_ENABLED=True
WEATHERFLOW_COLLECTOR_COLLECTOR_REST_STATS_ENABLED=True
# One-time backfill of your station's history; turn off again afterwards.
WEATHERFLOW_COLLECTOR_COLLECTOR_REST_IMPORT_ENABLED=False

# Prometheus output (optional; off by default). See the README.
# WEATHERFLOW_COLLECTOR_STORAGE_PROMETHEUS_SCRAPE_ENABLED=False
# WEATHERFLOW_COLLECTOR_STORAGE_PROMETHEUS_REMOTE_WRITE_ENABLED=False
# WEATHERFLOW_COLLECTOR_STORAGE_PROMETHEUS_REMOTE_WRITE_URL=<REMOTE_WRITE_URL>
# WEATHERFLOW_COLLECTOR_STORAGE_PROMETHEUS_REMOTE_WRITE_AUTH=sigv4
# WEATHERFLOW_COLLECTOR_STORAGE_PROMETHEUS_REMOTE_WRITE_SIGV4_REGION=<AWS_REGION>
# AWS_ACCESS_KEY_ID=<ACCESS_KEY_ID_WITH_APS_REMOTE_WRITE_ONLY>
# AWS_SECRET_ACCESS_KEY=<SECRET_ACCESS_KEY>
# To send only to Prometheus, turn InfluxDB off:
# WEATHERFLOW_COLLECTOR_STORAGE_INFLUXDB_ENABLED=False

# Websocket server (optional; off by default, localhost only). See the README.
# WEATHERFLOW_COLLECTOR_PROVIDER_WEBSOCKET_SERVER_ENABLED=False
# WEATHERFLOW_COLLECTOR_PROVIDER_WEBSOCKET_SERVER_HOST=127.0.0.1
# Browser origins allowed to connect, comma separated (none by default):
# WEATHERFLOW_COLLECTOR_PROVIDER_WEBSOCKET_SERVER_ORIGINS=https://<GRAFANA_HOST>
